# Fuel Rivals deployment settings. Copy to `.env` next to docker-compose.yml on the machine (chmod 600 .env) and fill in.
# NEVER commit the real .env. Generate secrets with:  openssl rand -hex 32
# Lines marked USER need something only you have (a domain, a Steam key); the rest can be generated.

# --- Where ---
# USER: the domain that points at the machine (A record), without https://. The web game, /api and /ws/N all live here.
DOMAIN=play.example.com
# USER: your e-mail, for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
# GitHub user or organization that owns the images in ghcr.io, in lower case.
GHCR_OWNER=your-github-user
# Image tags. `latest` follows the main branch; use a version tag (v0.1.0) to pin.
API_TAG=latest
GAME_TAG=latest
# Folder with the Godot web export (index.html, index.wasm, index.pck, ... and their .br files).
WEB_DIR=./web

# --- Secrets (generate) ---
POSTGRES_PASSWORD=change-me
# 32 or more bytes as hex. Game server keys are derived from it: if you change it, every server must be registered again.
MASTER_KEY=change-me-openssl-rand-hex-32
# 16 or more characters; salts the hashes kept for bans. Changing it forgets the existing bans.
BAN_SALT=change-me-openssl-rand-hex-16
# 24 or more characters. Bearer token of /api/admin/*.
ADMIN_TOKEN=change-me-openssl-rand-hex-24
# 24 or more characters. Bearer token that allows POST /api/servers/register.
SERVER_REGISTER_TOKEN=change-me-openssl-rand-hex-24

# --- Steam (USER: needs your own App ID and a publisher Web API key from Steamworks; see docs/DEPLOY_ORACLE.md) ---
# 480 (Spacewar) is the development App ID. Replace it with the real one (or the Playtest's) when you have it.
STEAM_APP_ID=480
STEAM_TICKET_IDENTITY=fuelrivals
# Publisher key for ISteamUserAuth/AuthenticateUserTicket. Empty: the desktop login answers 503.
STEAM_PARTNER_API_KEY=
# Ordinary Web API key (https://steamcommunity.com/dev/apikey) for the persona name. Empty: names become P + 4 digits.
STEAM_WEB_API_KEY=

# --- Game servers (filled in after `POST /api/servers/register`, one pair per process) ---
GAME1_ID=
GAME1_KEY=
GAME2_ID=
GAME2_KEY=
GAME_MAX_ROOMS=40

# --- Matchmaking (docs/MATCHMAKING.md; seconds) ---
# 16 or more characters. Bearer token of GET /api/metrics (Prometheus). Empty: metrics are off (404).
METRICS_TOKEN=
QUEUE_MAX_WAIT=30
QUEUE_SOLO_WAIT=30
READY_SECONDS=15
MAX_PING_MS=250

LOG_LEVEL=info
