# syntax=docker/dockerfile:1.7
# The Fuel Rivals game server (Godot headless, SPEC_ONLINE 3, 15.3 and 16.1.10).
#
# The server is a script (scripts/server/server_main.gd, `-s`), not an exported game, so the image runs it with the
# official Godot editor binary for the image's architecture and the project's scripts. It needs no import step and no
# export templates: it loads only scripts (scripts/server, scripts/net, scripts/sim), never assets or scenes.
#
# Build (the deploy workflow does it for arm64 and amd64 on every v* tag):
#   docker buildx build -f deploy/Dockerfile.gameserver --platform linux/arm64,linux/amd64 \
#       -t ghcr.io/OWNER/fuelrivals-gameserver:dev --push .
#
# Settings: FUEL_API_URL, FUEL_SERVER_ID and FUEL_SERVER_KEY from the environment (so the key never shows in `ps`);
# the rest as arguments after the entrypoint's `--` (docker-compose.yml's `command`): --port, --capacity, --region.
# user:// (the results outbox and the replays) is under XDG_DATA_HOME, a volume, because the container is read-only.

ARG GODOT_VERSION=4.7.2-stable

FROM debian:bookworm-slim AS godot
ARG TARGETARCH
ARG GODOT_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /dl
# Checked against the release's SHA512-SUMS.txt, as in ci.yml.
RUN case "${TARGETARCH}" in amd64) arch=x86_64 ;; arm64) arch=arm64 ;; *) echo "unsupported ${TARGETARCH}" >&2; exit 1 ;; esac \
 && zip="Godot_v${GODOT_VERSION}_linux.${arch}.zip" \
 && base="https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}" \
 && curl -fsSL --retry 3 -o "$zip" "$base/$zip" \
 && curl -fsSL --retry 3 -o SHA512-SUMS.txt "$base/SHA512-SUMS.txt" \
 && awk -v zip="$zip" '$2 == zip' SHA512-SUMS.txt >"$zip.sha512" \
 && [ "$(wc -l <"$zip.sha512")" -eq 1 ] \
 && sha512sum --check --strict "$zip.sha512" \
 && unzip -q "$zip" \
 && mv "Godot_v${GODOT_VERSION}_linux.${arch}" /godot \
 && chmod +x /godot

FROM debian:bookworm-slim AS runtime
# Godot's Linux binaries need these shared libraries even headless.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libfontconfig1 libx11-6 libxcursor1 libxi6 libxrandr2 libxinerama1 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --create-home --uid 10001 game \
 && mkdir -p /var/lib/fuelrivals && chown game /var/lib/fuelrivals
COPY --from=godot /godot /usr/local/bin/godot
COPY project.godot /game/project.godot
COPY scripts/ /game/scripts/
USER game
ENV XDG_DATA_HOME=/var/lib/fuelrivals XDG_CONFIG_HOME=/tmp/config XDG_CACHE_HOME=/tmp/cache
EXPOSE 9080
ENTRYPOINT ["godot", "--headless", "--path", "/game", "-s", "res://scripts/server/server_main.gd", "--"]
CMD ["--port=9080"]
STOPSIGNAL SIGTERM
